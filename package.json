{
  "name": "cutroom",
  "version": "0.1.0",
  "private": true,
  "description": "An agent-native desktop video editor: plain-JSON projects, live reload, FFmpeg export and a built-in MCP server.",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "mcp": "node mcp/server.mjs",
    "test": "node --test \"test/*.test.js\"",
    "smoke": "vite build && electron . --smoke"
  },
  "allowScripts": {
    "electron": true,
    "esbuild": true
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "vite": "^8.3.5"
  }
}
