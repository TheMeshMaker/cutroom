{
  "name": "cutroom",
  "version": "0.5.0",
  "private": true,
  "description": "A CapCut-style desktop video editor: a native Rust app (iced, no web view) with local AI audio tools and a built-in MCP server.",
  "author": "TheMeshMaker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cargo run --manifest-path native/Cargo.toml",
    "start": "cargo run --release --manifest-path native/Cargo.toml",
    "dist": "cargo build --release --manifest-path native/Cargo.toml",
    "mcp": "node mcp/server.mjs",
    "test": "node --test \"test/*.test.js\"",
    "shots": "node test/shots.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  }
}
